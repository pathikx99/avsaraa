# ==============================================================================
# AVSARAA ATELIER - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Server & Cloud API Configuration
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_secret_role_key_here
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Next.js Client-Side Supabase Variables (Bundled into browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# ------------------------------------------------------------------------------
# 2. Site & Public Web Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://avsaraa.in

# ------------------------------------------------------------------------------
# 3. Administrator Authority & Cryptographic Secrets (Server-Side Only)
# ------------------------------------------------------------------------------
ADMIN_EMAIL=contact.avsaraa@gmail.com
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_JWT_SECRET=your_32_character_minimum_random_secret_here
OTP_PROOF_SECRET=your_otp_proof_verification_salt_secret_here

# ------------------------------------------------------------------------------
# 4. Payment Gateway (Razorpay)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_your_key_id_here
RAZORPAY_KEY_ID=rzp_live_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ------------------------------------------------------------------------------
# 5. Shipping & Logistics (Shiprocket)
# ------------------------------------------------------------------------------
SHIPROCKET_EMAIL=your_shiprocket_account_email_here
SHIPROCKET_PASSWORD=your_shiprocket_account_password_here
SHIPROCKET_API_TOKEN=your_shiprocket_standalone_api_token_here
SHIPROCKET_WEBHOOK_TOKEN=your_shiprocket_webhook_token_here
SHIPROCKET_WEBHOOK_SECRET=your_shiprocket_webhook_secret_here

# ------------------------------------------------------------------------------
# 6. Transactional Email Service (Resend)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key_here
ADMIN_NOTIFICATION_EMAIL=contact.avsaraa@gmail.com
ORDER_SENDER_EMAIL=Avsaraa Luxury <orders@avsaraa.in>
SUPPORT_SENDER_EMAIL=Avsaraa Support <support@avsaraa.in>
VERIFICATION_SENDER_EMAIL=Avsaraa Verification <verify@avsaraa.in>

# ------------------------------------------------------------------------------
# 7. Cloudflare R2 Media Storage ($0 Egress - Optional; defaults to Supabase)
# ------------------------------------------------------------------------------
# When you create a free Cloudflare account, paste your R2 credentials here.
# The app will automatically switch image uploads to Cloudflare R2 ($0 egress fees).
# If left blank, the app safely defaults to Supabase Storage.
R2_ACCOUNT_ID=your_cloudflare_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=avsaraa-products
R2_PUBLIC_URL_PREFIX=https://pub-yourhash.r2.dev

# ------------------------------------------------------------------------------
# 8. Google OAuth Credentials (Google Sign-In / Supabase Auth)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ------------------------------------------------------------------------------
# 9. WhatsApp Business Gateway (Meta WhatsApp Cloud API or Twilio WhatsApp)
# ------------------------------------------------------------------------------
# Meta WhatsApp Cloud API (Recommended for Indian numbers):
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id_here
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_meta_waba_account_id_here
WHATSAPP_TEMPLATE_NAME=avsaraa_auth_otp
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_meta_webhook_verify_token_here

# Alternative: Twilio WhatsApp
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886



